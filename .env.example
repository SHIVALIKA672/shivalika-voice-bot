# Copy this file to ".env" for local testing. On Vercel, add the same names under
# Project → Settings → Environment Variables. You only need ONE key.

# Recommended: free key from https://console.groq.com/keys
# One Groq key powers both the answers (LLM) and the speech-to-text (Whisper).
GROQ_API_KEY=

# Optional alternatives / extra fallbacks (used in this order after Groq):
# GEMINI_API_KEY=      # free key from https://aistudio.google.com/apikey (answers only)
# OPENAI_API_KEY=      # paid; answers + speech-to-text

# Optional overrides
# LLM_PROVIDER=groq    # groq | gemini | openai — which configured provider to try first
# LLM_MODEL=           # force a specific chat model for that provider
# STT_MODEL=           # force a specific speech-to-text model
# STT_LANGUAGE=en      # language hint for speech-to-text ("" = auto-detect)
